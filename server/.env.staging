# Server
PORT=3002
NODE_ENV=staging

# Database (Staging isolated DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vastu_staging?schema=public"

# JWT
ACCESS_TOKEN_SECRET=staging-access-token-secret
REFRESH_TOKEN_SECRET=staging-refresh-token-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS
CLIENT_URL=http://localhost:5173
